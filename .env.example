# Existing frontend Supabase configuration is for recruitment only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only payments. Use a separate TEST Supabase project for previews.
PAYMENTS_ENABLED=false
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYMENTS_SUPABASE_URL=
PAYMENTS_SUPABASE_SECRET_KEY=
# Exact HTTPS preview origin; no path or trailing route.
PAYMENTS_SITE_URL=
PAYMENTS_USD_ENABLED=false
# Live mode requires this AND VERCEL_ENV=production. Never enable in previews.
PAYMENTS_ALLOW_LIVE=false

# Billing auth uses the payments project's PUBLIC key, never its secret key.
VITE_BILLING_SUPABASE_URL=
VITE_BILLING_SUPABASE_PUBLISHABLE_KEY=
# Server-only random 32-byte hex secret; keep stable to preserve private links.
PAYMENTS_LINK_SECRET=
