{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/careers", "destination": "/index.html" },
    { "source": "/careers/(.*)", "destination": "/index.html" },
    { "source": "/recruitment-preview", "destination": "/index.html" },
    { "source": "/recruitment-preview/(.*)", "destination": "/index.html" }
  ]
}
